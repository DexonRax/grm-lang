extern "raylib.h";
extern <math.h>;

struct Pair{
    float a;
    float b;
}

fn Vector2 project(Vector3 v, Vector3 offset, float rotation){
    Vector3 rotated;
    rotated.x = v.x * cosf(rotation) + v.z * sinf(rotation);
    rotated.y = v.y;
    rotated.z = -v.x * sinf(rotation) + v.z * cosf(rotation);

    Vector3 world;
    world.x = offset.x + rotated.x;
    world.y = offset.y + rotated.y;
    world.z = offset.z + rotated.z;

    float _x = world.x / world.z;
    float _y = world.y / world.z;

    Vector2 proj;

    proj.x = ((_x + 1) / 2) * GetScreenWidth();
    proj.y = (1 - (_y + 1) / 2) * GetScreenHeight();

    return proj;
}

struct Model3D{
    Vector3* vs;
    Vector3 position;
    int vc;
    float rotation;
    Pair* fs;
    int fc;

    fn void genCube(Model3D& self){
        self.vc = 8;
        self.vs = malloc(sizeof(Vector3)*self.vc);
        self.rotation = 0.f;

        self.fc = 12;
        self.fs = malloc(sizeof(Pair) * self.fc);

        int i = 0;
        for(int z = 0; z < 2; z++){
            for(int y = 0; y < 2; y++){
                for(int x = 0; x < 2; x++){

                    self.vs[i].x = x < 1 ? -0.5f : 0.5f;
                    self.vs[i].y = y < 1 ? -0.5f : 0.5f;
                    self.vs[i].z = z < 1 ? -0.5f : 0.5f;

                    i++;

                }
            }
        }

        self.fs[0].a = 0;
        self.fs[0].b = 1;

        self.fs[1].a = 1;
        self.fs[1].b = 3;

        self.fs[2].a = 3;
        self.fs[2].b = 2;

        self.fs[3].a = 2;
        self.fs[3].b = 0;


        self.fs[4].a = 4;
        self.fs[4].b = 5;

        self.fs[5].a = 5;
        self.fs[5].b = 7;

        self.fs[6].a = 7;
        self.fs[6].b = 6;

        self.fs[7].a = 6;
        self.fs[7].b = 4;


        self.fs[8].a = 0;
        self.fs[8].b = 4;

        self.fs[9].a = 1;
        self.fs[9].b = 5;

        self.fs[10].a = 3;
        self.fs[10].b = 7;

        self.fs[11].a = 2;
        self.fs[11].b = 6;

        /*
        0, 1, 3, 2, 0
        4, 5, 7, 6, 4
        */
        

    }

    fn void setPos(Model3D& self, float x, float y, float z){
        self.position.x = x;
        self.position.y = y;
        self.position.z = z;
    }

    fn void draw(Model3D& self){
        for(int i = 0; i < self.fc; ++i){

            int i1 = self.fs[i].a;
            int i2 = self.fs[i].b;

            Vector3 v1 = self.vs[i1];
            Vector3 v2 = self.vs[i2];

            DrawLineV(project(v1, self.position, self.rotation), project(v2, self.position, self.rotation), RED);

            //DrawCircleV(proj_x, proj_y, 10.f, RED);
        }
    }

    fn void delete(Model3D& self){
        free(self.vs);
        free(self.fs);
    }

}

fn int main(){
    InitWindow(800, 800, "a");
    defer CloseWindow();

    Model3D model;
    model.genCube();
    model.setPos(0.f, 0.f, 3.f);
    defer model.delete();

    Model3D model2;
    model2.genCube();
    model2.setPos(-2.f, 0.f, 6.f);
    defer model2.delete();


    SetTargetFPS(60);
    while(!WindowShouldClose()){
        BeginDrawing();
        ClearBackground(BLACK);

        model.rotation += 0.01f;
        model.draw();

        model2.rotation += 0.2f;

        model2.draw();

        EndDrawing();
    }


    return 0;
}